# Copy this file to ".env" and fill in your values.
# Your Jira Cloud site, no trailing slash, e.g. https://mycompany.atlassian.net
JIRA_SITE=https://YOURSITE.atlassian.net

# The email of your Atlassian account
JIRA_EMAIL=you@example.com

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here

# Optional: default project key used when creating items (e.g. PROJ)
JIRA_PROJECT=

# Optional: issue types treated as "roots" of the tree (comma separated)
JIRA_ROOT_TYPES=Epic,Task,Story

# Optional: hide items in the "Done" category (Completed/Done/Cancelled) by
# default. The UI has a "Show completed" toggle that overrides this per view.
JIRA_HIDE_DONE=true
