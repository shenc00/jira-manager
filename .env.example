# Copy this file to ".env" and fill in your values.
# Your Jira Cloud site, no trailing slash, e.g. https://mycompany.atlassian.net
JIRA_SITE=https://YOURSITE.atlassian.net

# The email of your Atlassian account
JIRA_EMAIL=you@example.com

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here

# Optional: default project key used when creating items (e.g. PROJ)
JIRA_PROJECT=

# Optional: address the Monthly Report is emailed to (via your local Outlook).
# Leave blank to use your JIRA_EMAIL above.
JIRA_REPORT_EMAIL=

# How the report email is delivered via Outlook:
#   display = open the draft in Outlook so you can review and click Send
#             (default - reliable; silent send often gets stuck in the Outbox)
#   send    = send it silently without opening Outlook
JIRA_EMAIL_MODE=display

# Optional: issue types treated as "roots" of the tree (comma separated)
JIRA_ROOT_TYPES=Epic,Task,Story

# Optional: hide items in the "Done" category (Completed/Done/Cancelled) by
# default. The UI has a "Show completed" toggle that overrides this per view.
JIRA_HIDE_DONE=true

# Optional: automatically cancel items that have been "On Hold" too long.
# When true, on every app load (and on Refresh) items assigned to you that have
# been in JIRA_ONHOLD_STATUS for more than JIRA_ONHOLD_MONTHS are transitioned
# to JIRA_CANCEL_STATUS. This writes to Jira immediately -- leave false unless
# you want that. JIRA_AUTO_CANCEL_CAP pauses for confirmation if an unusually
# large number would be cancelled at once. A log is written to data/auto_cancel.log.
JIRA_AUTO_CANCEL_STALE_ONHOLD=false
JIRA_ONHOLD_STATUS=On Hold
JIRA_CANCEL_STATUS=Cancelled
JIRA_ONHOLD_MONTHS=6
JIRA_AUTO_CANCEL_CAP=25

# TLS / corporate proxy. The app trusts the OS certificate store automatically
# (via truststore), which handles most HTTPS-inspection proxies. Only set these
# if you still get SSL certificate errors:
#   JIRA_CA_BUNDLE=C:\path\to\corporate-root-ca.pem   # trust a specific CA
#   JIRA_VERIFY_SSL=false                              # last resort: skip verify
JIRA_VERIFY_SSL=true
JIRA_CA_BUNDLE=
